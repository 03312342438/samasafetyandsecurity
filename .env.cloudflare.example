# =============================================================================
# SELF-HOST CONFIG — point the whole app at YOUR OWN Supabase project.
# =============================================================================
# Copy this file to `.env.cloudflare` and fill in the values from your Supabase
# project dashboard (Project Settings -> API). Then run:
#
#     npx wrangler login          # one time
#     bash scripts/deploy-cloudflare.sh
#
# The deploy script reads this file, BUILDS the browser bundle with your public
# keys baked in, and pushes the server-side values to your Worker as secrets.
# Keep this file private — never commit it. (.env.cloudflare is gitignored.)
# =============================================================================

# --- PUBLIC keys (safe in the browser bundle) --------------------------------
# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Project Settings -> API -> Project API keys -> "anon" / "publishable"
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Project Settings -> General -> Reference ID
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ref

# Existing APP_SUPABASE_* values are also accepted by the deployment script.
# If you use these names, you may leave the matching VITE_/SUPABASE_ values
# above and below empty; the script maps them automatically.
APP_SUPABASE_URL=
APP_SUPABASE_PUBLISHABLE_KEY=

# --- SERVER-SIDE secrets (never exposed to the browser) ----------------------
# Same URL as above (the server reads this name).
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Same publishable/anon key as above (the server reads this name).
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Project Settings -> API -> Project API keys -> "service_role" / "secret".
# REQUIRED for admin user management + hidden-admin seeding.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY
APP_SUPABASE_SERVICE_ROLE_KEY=

# Worker behind sama.safetyportal.workers.dev. Change only if your Worker uses
# another name.
CLOUDFLARE_WORKER_NAME=sama

# --- Hidden admin auto-seed (used only if SUPABASE_SERVICE_ROLE_KEY is set) ---
HIDDEN_ADMIN_EMAIL=rail@bfginternational.com
HIDDEN_ADMIN_PASSWORD=Bfgx123@

# --- Email sending (report distribution), optional ---------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Lovable AI gateway key (only if you use AI features), optional -----------
LOVABLE_API_KEY=
